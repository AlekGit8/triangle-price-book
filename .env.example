# Copy to .env.local and fill in. Never commit real keys.
# See README.md for where to find each value.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin moderation (pick a long random string; used as the /admin password)
ADMIN_KEY=

# Cloudflare Turnstile (optional spam protection on /submit)
# Get keys at https://dash.cloudflare.com -> Turnstile. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
