# Copy to .env.local and fill in. Never commit real keys.
# See README.md for where to find each value.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin moderation (pick a long random string; used as the /admin password)
ADMIN_KEY=

# Cloudflare Turnstile (optional spam protection on /submit)
# Get keys at https://dash.cloudflare.com -> Turnstile. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gemini (optional: AI document extraction on /submit — FREE tier)
# Get a free key at https://aistudio.google.com/apikey (no billing needed).
# Uses gemini-3.5-flash-lite only (free-tier eligible, good until Jul 21,
# 2027). Leave blank to disable auto-fill; the form still works manually
# and the upload attaches as the invoice.
GEMINI_API_KEY=
