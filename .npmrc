# @cloudflare/next-on-pages@1.13.16 caps its Next.js peer range at <=15.5.2,
# but the project runs 15.5.28 (security patch for CVE-2026-96889 and
# GHSA-p3m5-59mp-jv5r). 15.5.28 is a patch release in the same minor line,
# so the adapter works fine — npm just needs to skip the strict peer check.
legacy-peer-deps=true
